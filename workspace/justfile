# Jade — workspace-level dev orchestration.
#
# Canonical copy. To use it, run the bootstrap script from your Jade
# workspace root — the directory holding the jade-* repos and the `.github`
# checkout:
#
#     ./.github/workspace/bootstrap.sh
#
# That writes a one-line shim `justfile` at the root; then run `just` from there.
# See README.md next to this file. Each repo also has its own justfile; this
# forwards to them and adds cross-repo helpers.

# List recipes
_default:
    @just --list

# Forward a recipe to the backend repo, e.g. `just backend migrate`
backend *args:
    cd jade-backend && just {{args}}

# Forward a recipe to the iOS repo, e.g. `just ios run`
ios *args:
    cd jade-ios && just {{args}}

# Forward a recipe to the docs repo, e.g. `just docs serve`
docs *args:
    cd jade-docs && just {{args}}

# Forward a recipe to the Mac app repo, e.g. `just mac run` (renamed from `desktop`; see README.md)
mac *args:
    cd jade-macos && just {{args}}

# Run all automated test suites (backend + iOS)
test:
    cd jade-backend && just test
    cd jade-ios && just test

# Core-loop dev: start the backend in the background, then launch the iOS app
dev:
    #!/usr/bin/env bash
    set -euo pipefail
    (cd jade-backend && nohup just serve > /tmp/jade-backend.log 2>&1 &)
    sleep 3
    cd jade-ios && just run
    echo "Backend log: /tmp/jade-backend.log"

# Stop the background dev backend started by `just dev`
stop:
    pkill -f "manage.py runserver" || true
